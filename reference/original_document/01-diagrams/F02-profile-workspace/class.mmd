---
config:
  layout: elk
---
classDiagram
    direction LR

    class Profile {
        +String id
        +String name
        +String status
        +DateTime deletedAt
        +DateTime hardDeleteAfter
        +Json settings
    }

    class Workspace {
        +String id
        +String name
        +String description
        +String profileId
        +String status
        +Boolean marketplaceOpen
        +DateTime deletedAt
        +DateTime hardDeleteAfter
    }

    class WorkspaceMember {
        +String id
        +String userId
        +String workspaceId
        +String role
        +DateTime joinedAt
    }

    class ProfileAccess {
        +String id
        +String userId
        +String profileId
        +ProfileRole role
        +DateTime grantedAt
        +Int clientId
    }

    class User {
        +String id
        +String username
        +UserRole role
        +Int sessionVersion
    }

    class UserHomeTopBar {
        +handleProfileSwitch(newProfileId)
    }

    class ProfileWorkspaceSwitcher {
        +handleWorkspaceSwitch(newWsId)
        +handleOpenCreateModal()
    }

    class CreateWorkspaceModal {
        +handleCreate()
        +handleRollover()
    }

    class WelcomePage {
        +render WelcomeClient
    }

    class ProfileActionsServer {
        +checkProfileAccess(profileId)
        +selectProfile(profileId)
        +getAvailableProfiles()
        +getMyProfilesAndWorkspaces()
        +createProfileForUser(name)
    }

    class ApiProfileSelect {
        +POST re-sign JWT sessionProfileId
    }

    class ApiWorkspaceFirst {
        +GET landing cho profile
    }

    class ProfileRoutingLib {
        +determineLandingForProfile(userId, profileId, isGlobalAdmin)
    }

    class WorkspaceActionsServer {
        +createWorkspaceAction(formData)
        +createNextMonthWithRollover(currentWorkspaceId)
        +getWorkspacesForProfile(profileId)
        +deleteWorkspaceAction(workspaceId)
        +restoreWorkspaceAction(workspaceId)
    }

    class ProfilePermissionsLib {
        +getProfileRole(userId, profileId)
        +canCreateWorkspace(userId, profileId)
        +isProfileOwner(userId, profileId)
    }

    class SecurityLib {
        +verifyWorkspaceAccess(workspaceId, minRole)
    }

    Profile "1" o-- "n" Workspace : profileId
    Workspace "1" *-- "n" WorkspaceMember : onDelete Cascade
    Profile "1" *-- "n" ProfileAccess : onDelete Cascade
    User "1" o-- "n" ProfileAccess : userId
    User "1" o-- "n" WorkspaceMember : userId

    UserHomeTopBar ..> ApiProfileSelect : fetch POST profileId
    UserHomeTopBar ..> ApiWorkspaceFirst : fetch GET profileId
    ProfileWorkspaceSwitcher ..> ProfileActionsServer : getMyProfilesAndWorkspaces()
    ProfileWorkspaceSwitcher ..> CreateWorkspaceModal : mở modal tạo workspace
    WelcomePage ..> ProfilePermissionsLib : isProfileOwner()
    WelcomePage ..> CreateWorkspaceModal : nút tạo workspace đầu tiên
    CreateWorkspaceModal ..> WorkspaceActionsServer : createWorkspaceAction và createNextMonthWithRollover
    ApiProfileSelect ..> ProfileAccess : findUnique userId_profileId
    ApiWorkspaceFirst ..> ProfileRoutingLib : determineLandingForProfile()
    ProfileRoutingLib ..> ProfileAccess : check role CLIENT
    ProfileRoutingLib ..> WorkspaceMember : rank role OWNER gt ADMIN gt MEMBER
    ProfileActionsServer ..> ProfileAccess : findMany theo userId
    ProfileActionsServer ..> Workspace : findMany theo profileId
    WorkspaceActionsServer ..> SecurityLib : verifyWorkspaceAccess()
    WorkspaceActionsServer ..> ProfilePermissionsLib : canCreateWorkspace()
    WorkspaceActionsServer ..> Workspace : create
    WorkspaceActionsServer ..> WorkspaceMember : create role OWNER

