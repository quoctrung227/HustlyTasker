---
config:
  layout: elk
---
classDiagram
    direction LR

    class LivePresenceBoard {
        <<client component>>
        +workspaceId from useParams
        +presence any[]
        +impersonatingId string
        +handleImpersonate(userId)
        +fetchData()
    }

    class ImpersonationBannerLayout {
        <<client component layout>>
        +username string
        +workspaceId string
        +handleStop()
    }

    class ImpersonationBannerWrapper {
        <<client component admin>>
        +impersonatedUsername string
        +expiresAtIso string
        +workspaceId string
        +handleStop()
    }

    class ImpersonationBannerAdmin {
        <<client component countdown>>
        +impersonatedUsername string
        +expiresAtIso string
        +secondsLeft number
        +onStop()
    }

    class ImpersonationActions {
        <<server action>>
        +startImpersonation(targetUserId, workspaceId)
        +stopImpersonation(workspaceId)
    }

    class SecurityLib {
        <<lib security.ts>>
        +verifyWorkspaceAccess(workspaceId, requiredRole)
    }

    class AuthLib {
        <<lib auth.ts>>
        +getSession()
        +createImpersonationSession(originalUser, targetUser)
        +stopImpersonationSession()
    }

    class AuditLogLib {
        <<lib audit-log.ts>>
        +audit(opts) non-throwing
    }

    class JwtSessionCookie {
        <<cookie JWT không phải model DB>>
        +cookie session
        +cookie admin_session standby
        +isImpersonating bool
        +originalAdminId string
        +impersonationExpiresAt ISO
        +exp 2h TTL
    }

    class User {
        <<Prisma model>>
        +id String
        +username String
        +nickname String
        +role UserRole
        +email String
        +sessionVersion Int
    }

    class Workspace {
        <<Prisma model>>
        +id String
        +profileId String
        +status String
    }

    class WorkspaceMember {
        <<Prisma model>>
        +userId String
        +workspaceId String
        +role String default MEMBER
    }

    class ProfileAccess {
        <<Prisma model>>
        +userId String
        +profileId String
        +role ProfileRole
        +grantedAt DateTime
    }

    class AuditLog {
        <<Prisma model>>
        +id BigInt
        +workspaceId String
        +actorUserId String
        +action String
        +targetType String
        +targetId String
        +ipAddress String
        +userAgent String
    }

    LivePresenceBoard ..> ImpersonationActions : gọi startImpersonation
    ImpersonationBannerLayout ..> ImpersonationActions : gọi stopImpersonation
    ImpersonationBannerWrapper ..> ImpersonationActions : gọi stopImpersonation
    ImpersonationBannerWrapper --> ImpersonationBannerAdmin : render với onStop

    ImpersonationActions ..> SecurityLib : guard ADMIN
    ImpersonationActions ..> AuthLib : tạo và gỡ session
    ImpersonationActions ..> AuditLogLib : ghi audit
    ImpersonationActions ..> WorkspaceMember : check target là member
    ImpersonationActions ..> ProfileAccess : check role OWNER ADMIN elsewhere
    ImpersonationActions ..> Workspace : lấy profileId
    ImpersonationActions ..> User : load target user

    AuthLib ..> JwtSessionCookie : encrypt 2h set cookie
    AuditLogLib ..> AuditLog : prisma create
    SecurityLib ..> User : check LOCKED sessionVersion
    SecurityLib ..> ProfileAccess : resolve workspaceRole
    SecurityLib ..> WorkspaceMember : fallback membership

    WorkspaceMember --> User : userId
    WorkspaceMember --> Workspace : workspaceId
    ProfileAccess --> User : userId
    AuditLog --> Workspace : workspaceId
    AuditLog --> User : actorUserId

