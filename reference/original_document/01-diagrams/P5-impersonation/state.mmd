stateDiagram-v2
    state "Chưa đăng nhập (không có cookie session)" as ChuaDangNhap
    state "Phiên admin bình thường (cookie session = JWT admin, TTL 30 ngày)" as PhienAdmin
    state "Đang nhập vai (cookie session = JWT target với isImpersonating true, originalAdminId, impersonationExpiresAt. Cookie admin_session = JWT admin gốc. Cả hai TTL 2 giờ)" as DangNhapVai
    state "Phiên admin khôi phục (cookie session = JWT admin từ admin_session, expiry 7 ngày. admin_session bị xóa)" as PhienKhoiPhuc
    state "Buộc đăng nhập lại (admin_session mất hoặc hết hạn — cả hai cookie bị xóa)" as BuocDangNhapLai

    [*] --> ChuaDangNhap
    ChuaDangNhap --> PhienAdmin: login / loginWithProfile
    PhienAdmin --> DangNhapVai: startImpersonation qua guard, createImpersonationSession + audit auth.impersonation_started
    DangNhapVai --> PhienKhoiPhuc: stopImpersonation, stopImpersonationSession khôi phục admin_session + audit auth.impersonation_ended
    DangNhapVai --> BuocDangNhapLai: hết TTL 2 giờ, JWT exp chết cả hai cookie (banner countdown về 0 tự gọi onStop)
    DangNhapVai --> BuocDangNhapLai: stopImpersonation nhưng admin_session không còn, cookie session bị xóa
    PhienKhoiPhuc --> PhienAdmin: tiếp tục làm việc như phiên admin thường
    PhienAdmin --> ChuaDangNhap: logout
    BuocDangNhapLai --> ChuaDangNhap: về trang login
    ChuaDangNhap --> [*]

