---
config:
  layout: elk
---
stateDiagram-v2
    state "Đang đợi giao" as DangDoiGiao
    state "Nhận task" as NhanTask
    state "Đã nhận task" as DaNhanTask
    state "Đang thực hiện" as DangThucHien
    state "Revision" as RevisionSt
    state "Quá hạn" as QuaHan
    state "Hoàn tất" as HoanTat
    state "Đã hủy" as DaHuy

    state "Review module - 6 status video A2-A7" as ReviewModule {
        state "Đã nộp video (nội bộ)" as A2
        state "Đang sửa feedback (nội bộ)" as A3
        state "Đã sửa feedback (nội bộ)" as A4
        state "Đã gửi video (khách)" as A5
        state "Đã nhận feedback (khách)" as A6
        state "Đã sửa feedback (khách)" as A7

        A2 --> A3 : admin chốt feedback-done
        A4 --> A3 : admin mở vòng feedback mới
        A3 --> A4 : editor confirm-fix
        A4 --> A2 : re-upload Mux READY
        A4 --> A5 : admin approve-send
        A2 --> A5 : admin approve-send (không cần sửa)
        A5 --> A2 : re-upload sau khi đã gửi khách
        A5 --> A6 : guest request changes
        A6 --> A7 : editor confirm client fix
        A7 --> A5 : admin gửi lại khách
    }

    [*] --> DangDoiGiao : createTask / batch không assignee
    [*] --> NhanTask : createTask / batch có assignee
    DangDoiGiao --> NhanTask : assignTask admin / claimTask marketplace
    NhanTask --> DangDoiGiao : unassign hoặc sys-revoke (xóa assignee)
    NhanTask --> DangThucHien : editor start (isUserStart)
    DaNhanTask --> DangThucHien : editor start (variant)
    DangThucHien --> RevisionSt : editor nộp productLink (isUserDelivery)
    RevisionSt --> DangThucHien : admin resume sau feedback
    DangThucHien --> A2 : upload bản dựng - Mux READY
    RevisionSt --> A2 : upload bản dựng - Mux READY
    DangThucHien --> QuaHan : cron check-deadline (whitelist cronOverdueEligible)
    QuaHan --> DangThucHien : admin/editor chỉnh tay (FSM off)
    RevisionSt --> HoanTat : admin complete
    ReviewModule --> HoanTat : confirmTaskHoanTat (drawer review)
    DangThucHien --> DaHuy : admin cancel (auto isArchived true)
    DaHuy --> NhanTask : restoreCancelledTask có assignee
    DaHuy --> DangDoiGiao : restoreCancelledTask không assignee
    HoanTat --> RevisionSt : admin reopen (chỉ admin - guard terminal H3)
    HoanTat --> [*]

