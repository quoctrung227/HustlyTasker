---
config:
  layout: elk
---
classDiagram
    direction LR

    class ScheduleRule {
        +String id
        +String userId
        +String workspaceId
        +String profileId
        +Int dayOfWeek
        +String startTime
        +String endTime
        +String timezone
        +Boolean isActive
        +String updatedById
        +Int version
    }

    class ScheduleException {
        +String id
        +String userId
        +String workspaceId
        +String profileId
        +DateTime date
        +String startTime
        +String endTime
        +ScheduleExceptionType type
        +String reason
        +String updatedById
    }

    class ScheduleExceptionType {
        <<enumeration>>
        BLOCK
        ADD
    }

    class DailyAvailability {
        +String id
        +String userId
        +String workspaceId
        +String profileId
        +DateTime date
        +Json schedule24slot
    }

    class User {
        +String id
        +String username
        +String nickname
        +String role
    }

    class UserSchedulePage {
        <<ServerPage>>
        +docRuleVaExceptionCuaChinhUser()
    }

    class AdminSchedulePage {
        <<ServerPage>>
        +docRuleVaExceptionToanBoStaff()
        +isMobileDevice()
    }

    class MissionControlCalendarPage {
        <<ServerPage>>
        +verifyProfileAdminAccess()
    }

    class OptimisticGrid {
        <<ClientComponent>>
        +useOptimistic()
        +createBatchScheduleExceptions()
        +deleteScheduleExceptionsByIds()
        +deleteScheduleExceptionsForDay()
    }

    class MobileScheduleView {
        <<ClientComponent>>
    }

    class AvailabilityWeekEditor {
        <<ClientComponentLegacy>>
        +saveMyAvailability()
    }

    class ScheduleActions {
        <<ServerActions>>
        +upsertScheduleRule()
        +deleteScheduleRule()
        +createScheduleException()
        +createBatchScheduleExceptions()
        +deleteScheduleException()
        +deleteScheduleExceptionsByIds()
        +deleteScheduleExceptionsForDay()
        +getEffectiveAvailability()
        -validateAccess()
    }

    class AvailabilityActions {
        <<ServerActions>>
        +getMyAvailability()
        +getMyAvailabilityWeek()
        +saveMyAvailability()
        +getAdminAvailabilityMatrix()
        +getAdminAvailabilityWeek()
        -ensureWorkspaceAccess()
    }

    class SecurityLib {
        <<Lib>>
        +verifyWorkspaceAccess(workspaceId, role)
        +verifyProfileAdminAccess(workspaceId)
    }

    class PrismaWorkspace {
        <<Lib>>
        +getWorkspacePrisma(workspaceId, profileId)
        +resolveActiveProfileId()
    }

    UserSchedulePage --> OptimisticGrid : render editable
    AdminSchedulePage --> OptimisticGrid : render readOnly
    AdminSchedulePage --> MobileScheduleView : mobile dispatcher
    OptimisticGrid ..> ScheduleActions : gọi server action
    AvailabilityWeekEditor ..> AvailabilityActions : saveMyAvailability
    MissionControlCalendarPage ..> AvailabilityActions : getAdminAvailabilityWeek
    ScheduleActions ..> SecurityLib : validateAccess gọi verifyWorkspaceAccess
    AvailabilityActions ..> SecurityLib : matrix yêu cầu ADMIN
    ScheduleActions ..> PrismaWorkspace : getWorkspacePrisma
    UserSchedulePage ..> PrismaWorkspace : đọc trực tiếp rule exception
    AdminSchedulePage ..> PrismaWorkspace : đọc trực tiếp rule exception
    ScheduleActions --> ScheduleRule : CRUD
    ScheduleActions --> ScheduleException : CRUD
    AvailabilityActions --> DailyAvailability : upsert findMany
    User "1" o-- "n" ScheduleRule
    User "1" o-- "n" ScheduleException
    User "1" o-- "n" DailyAvailability
    ScheduleException ..> ScheduleExceptionType : type

