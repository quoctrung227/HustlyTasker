sequenceDiagram
    autonumber
    actor Editor as Editor (staff)
    actor Admin as Admin
    participant Page as UserSchedulePage dashboard schedule
    participant Grid as OptimisticGrid (client)
    participant SA as schedule-actions.ts
    participant Sec as security.ts verifyWorkspaceAccess
    participant DB as Prisma (Neon Postgres)
    participant APage as AdminSchedulePage admin schedule
    participant MC as MissionControlCalendarPage mc lich
    participant AA as availability-actions.ts

    Editor->>Page: GET workspaceId dashboard schedule
    Page->>Page: getSession()
    alt không có session
        Page-->>Editor: redirect /login
    else role là CLIENT
        Page-->>Editor: redirect dashboard
    else session hợp lệ
        Page->>DB: scheduleRule.findMany và scheduleException.findMany (userId của mình)
        DB-->>Page: rules và exceptions tuần này
        Page-->>Grid: render items RULE BLOCK ADD
    end

    Editor->>Grid: kéo rê chọn khung giờ nhiều ngày
    Grid->>Grid: dispatch useOptimistic op ADD (tô màu ngày)
    Grid->>SA: createBatchScheduleExceptions(workspaceId, profileId, userId, entries)
    SA->>Sec: validateAccess gọi verifyWorkspaceAccess(workspaceId, MEMBER)
    alt không phải member workspace
        Sec-->>SA: throw SECURITY_VIOLATION
        SA-->>Grid: lỗi
        Grid-->>Editor: toast lỗi và rollback optimistic
    else MEMBER sửa lịch của người khác
        SA-->>Grid: throw Bạn không có quyền thay đổi lịch của người khác
        Grid-->>Editor: toast lỗi
    else được phép (ADMIN OWNER hoặc tự sửa lịch mình)
        SA->>DB: $transaction scheduleException.create mỗi entry (type BLOCK hoặc ADD, updatedById là caller)
        alt DB lỗi
            DB-->>SA: PrismaClientError
            SA-->>Grid: lỗi
            Grid-->>Editor: toast lỗi
        else tạo thành công
            DB-->>SA: danh sách created
            SA->>SA: revalidatePath admin schedule và dashboard schedule
            SA-->>Grid: count
            Grid-->>Editor: giữ ô đã tô (xác nhận optimistic)
        end
    end

    Admin->>APage: GET workspaceId admin schedule
    APage->>APage: getSession()
    alt không có session hoặc role CLIENT
        APage-->>Admin: redirect /login hoặc dashboard
    else session hợp lệ
        APage->>DB: user.findMany staff của profile
        APage->>DB: scheduleRule và scheduleException (userId in staffIds)
        DB-->>APage: matrix cả team
        APage-->>Admin: OptimisticGrid readOnly true (mobile dùng MobileScheduleView)
    end

    Admin->>MC: GET workspaceId mc lich
    MC->>Sec: verifyProfileAdminAccess(workspaceId)
    alt không phải admin profile
        Sec-->>MC: throw
        MC-->>Admin: redirect dashboard
    else là admin
        MC->>AA: getAdminAvailabilityWeek(todayKey, workspaceId)
        AA->>Sec: verifyWorkspaceAccess(workspaceId, ADMIN)
        alt không đủ quyền ADMIN workspace
            Sec-->>AA: throw SECURITY_VIOLATION
            AA-->>MC: object error (page catch về null, fallback vnWeekKeys)
        else ADMIN ok
            AA->>DB: dailyAvailability.findMany(profileId, workspaceId, date in tuần)
            DB-->>AA: records schedule EMPTY FREE BUSY TENTATIVE
            AA-->>MC: weekStartKey, days, users rows
        end
        MC-->>Admin: McCalendarBoard đếm ca rảnh theo ngày
    end

