stateDiagram-v2
    state "Chưa có record (mặc định 24 slot EMPTY)" as NoRecord
    state "EMPTY" as EMPTY
    state "FREE" as FREE
    state "BUSY" as BUSY
    state "TENTATIVE" as TENTATIVE

    [*] --> NoRecord
    NoRecord --> EMPTY : getMyAvailability trả DEFAULT_SCHEDULE
    NoRecord --> FREE : saveMyAvailability upsert create
    NoRecord --> BUSY : saveMyAvailability upsert create
    NoRecord --> TENTATIVE : saveMyAvailability upsert create

    EMPTY --> FREE : saveMyAvailability
    EMPTY --> BUSY : saveMyAvailability
    EMPTY --> TENTATIVE : saveMyAvailability
    FREE --> BUSY : saveMyAvailability
    FREE --> TENTATIVE : saveMyAvailability
    FREE --> EMPTY : saveMyAvailability xóa đánh dấu
    BUSY --> FREE : saveMyAvailability
    BUSY --> TENTATIVE : saveMyAvailability
    BUSY --> EMPTY : saveMyAvailability xóa đánh dấu
    TENTATIVE --> FREE : saveMyAvailability
    TENTATIVE --> BUSY : saveMyAvailability
    TENTATIVE --> EMPTY : saveMyAvailability xóa đánh dấu

    note right of NoRecord
        saveMyAvailability chặn sửa ngày quá khứ
        (targetDate nhỏ hơn todayDate thì trả lỗi)
        và chặn dateKey sai định dạng
    end note

    note right of EMPTY
        Giá trị ngoài bộ 4 status hợp lệ
        bị normalizeSchedule ép về EMPTY
    end note

