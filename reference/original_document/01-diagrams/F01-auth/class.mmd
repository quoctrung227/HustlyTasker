---
config:
  layout: elk
---
classDiagram
    direction LR

    class User {
      +String id
      +String username
      +String email
      +String password nullable
      +String googleId nullable
      +String authProvider
      +UserRole role
      +Boolean emailVerified
      +Int failedLoginAttempts
      +DateTime lockedUntil nullable
      +Int sessionVersion
      +DateTime lastLoginAt
      +String lastLoginIp
    }

    class Session {
      +String id
      +String userId
      +String ipAddress
      +DateTime startTime
      +DateTime endTime nullable
    }

    class EmailVerificationToken {
      +String tokenHash unique
      +String purpose EMAIL_VERIFICATION hoặc PASSWORD_RESET
      +String email
      +DateTime expiresAt
      +DateTime usedAt nullable
    }

    class PasswordResetOTP {
      +String otpHash
      +String purpose PASSWORD_RESET
      +Int attemptCount
      +DateTime expiresAt
      +DateTime consumedAt nullable
      +DateTime invalidatedAt nullable
    }

    class LoginAttempt {
      +String emailTried
      +Boolean success
      +String failReason
      +String ipAddress
    }

    class SignupPage {
      +fetch POST api auth signup
    }
    class LoginPage {
      +useActionState loginAction
    }
    class GoogleSignInButton {
      +link GET api auth google authorize
    }
    class ForgotPasswordPage {
      +StepEmail StepOtp StepPassword
    }

    class ApiAuthSignup {
      +POST(req)
    }
    class ApiAuthVerifyEmail {
      +GET(req)
      +POST(req)
      +verifyToken(rawToken)
    }
    class ApiAuthVerifyOtp {
      +POST(req)
    }
    class ApiAuthForgotPassword {
      +POST(req)
    }
    class ApiAuthResetPassword {
      +POST(req)
    }
    class ApiAuthGoogleAuthorize {
      +GET()
    }
    class ApiAuthGoogleCallback {
      +GET(req)
    }

    class SignupActions {
      +signupAction(input)
    }
    class AuthActions {
      +loginAction(prevState, formData)
      +logoutAction()
      +safeNextPath(raw)
    }
    class PasswordResetActions {
      +requestPasswordResetOtp(email)
      +verifyPasswordResetOtp(email, otp)
      +resetPasswordWithToken(rawToken, newPassword)
    }

    class AuthLib {
      +login(userData, opts)
      +loginWithProfile(userData, profileId, opts)
      +logout()
      +getSession()
    }
    class GoogleAuthLib {
      +getGoogleRedirectUri()
      +exchangeCodeForToken(code)
      +fetchGoogleUserInfo(accessToken)
      +findOrCreateGoogleUser(info)
    }
    class OtpLib {
      +generateOtp()
      +hashOtp(otp)
      +verifyOtp(otp, hash)
      +generateRandomToken()
      +hashToken(raw)
    }
    class RateLimitUpstash {
      +checkLoginIp(ip)
      +checkSignupIp(ip)
      +checkSignupEmail(email)
      +checkOtpIp(ip)
      +checkOtpEmail(email)
    }
    class EmailLib {
      +sendEmail(to, subject, html)
    }

    SignupPage ..> ApiAuthSignup : POST body email password username
    ApiAuthSignup ..> SignupActions : signupAction
    SignupActions ..> RateLimitUpstash : checkSignupIp checkSignupEmail
    SignupActions ..> OtpLib : generateRandomToken hashToken
    SignupActions ..> EmailLib : gửi mail verify link
    SignupActions --> User : tạo User Profile Workspace OWNER
    SignupActions --> EmailVerificationToken : tạo token TTL 24h

    ApiAuthVerifyEmail --> EmailVerificationToken : updateMany usedAt
    ApiAuthVerifyEmail --> User : set emailVerified true

    LoginPage ..> AuthActions : loginAction qua form action
    LoginPage *-- GoogleSignInButton
    AuthActions ..> RateLimitUpstash : checkLoginIp 10 mỗi phút
    AuthActions ..> AuthLib : loginWithProfile set cookie JWT
    AuthActions --> User : compare bcrypt, lockout 5 fail 15p
    AuthActions --> LoginAttempt : logLoginAttempt mỗi lần thử

    GoogleSignInButton ..> ApiAuthGoogleAuthorize : redirect
    ApiAuthGoogleAuthorize ..> GoogleAuthLib : getGoogleRedirectUri
    ApiAuthGoogleCallback ..> GoogleAuthLib : exchange code, userinfo, findOrCreate
    ApiAuthGoogleCallback ..> AuthLib : loginWithProfile
    GoogleAuthLib --> User : find googleId, link email, tạo mới

    ForgotPasswordPage ..> ApiAuthForgotPassword : bước 1 email
    ForgotPasswordPage ..> ApiAuthVerifyOtp : bước 2 OTP 6 số
    ForgotPasswordPage ..> ApiAuthResetPassword : bước 3 password mới
    ApiAuthForgotPassword ..> PasswordResetActions : requestPasswordResetOtp
    ApiAuthVerifyOtp ..> PasswordResetActions : verifyPasswordResetOtp
    ApiAuthResetPassword ..> PasswordResetActions : resetPasswordWithToken
    PasswordResetActions ..> RateLimitUpstash : checkOtpIp checkOtpEmail
    PasswordResetActions ..> OtpLib : generateOtp hashOtp verifyOtp
    PasswordResetActions ..> EmailLib : mail OTP và mail đổi mật khẩu
    PasswordResetActions --> PasswordResetOTP : tạo, đếm attempt, consume
    PasswordResetActions --> EmailVerificationToken : resetToken PASSWORD_RESET TTL 5p
    PasswordResetActions --> User : đổi password, tăng sessionVersion

    User o-- Session : sessions
    User o-- EmailVerificationToken : userId cascade
    User o-- PasswordResetOTP : userId cascade
    User o-- LoginAttempt : userId setnull

%% Nguồn code thật:
%% - User: prisma/schema.prisma:125 (password String? :136, googleId :137, emailVerified :158, failedLoginAttempts :163, lockedUntil :164, sessionVersion :170)
