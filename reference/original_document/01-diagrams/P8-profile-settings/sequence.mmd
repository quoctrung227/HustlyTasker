sequenceDiagram
    autonumber
    participant U as Nhân sự hoặc Admin
    participant UI as Trang Profile + components
    participant UA as upload-actions.ts
    participant PA as profile-actions.ts
    participant TA as tag-actions.ts
    participant GS as global-settings.ts
    participant LIB as lib auth + security
    participant BLOB as Vercel Blob
    participant DB as Prisma (Neon)

    rect rgb(240, 248, 255)
    note over U,DB: Luồng 1 — Upload avatar (AvatarUpload.tsx)
    U->>UI: Chọn ảnh avatar
    UI->>UA: uploadAvatar(userId, formData)
    UA->>LIB: getSession()
    alt Chưa đăng nhập
        UA-->>UI: error Bạn cần đăng nhập
    else Có session (bỏ qua userId từ client - chống IDOR)
        UA->>UA: validateImageFile + check size 10MB
        alt File sai định dạng hoặc quá 10MB
            UA-->>UI: error Định dạng không hỗ trợ hoặc quá 10MB
        else File hợp lệ
            UA->>UA: sharp rotate + resize 512x512 + webp
            alt Sharp không parse được ảnh
                UA-->>UI: error Không xử lý được ảnh
            else Xử lý OK
                UA->>BLOB: uploadPublicImage(avatar-userId-ts.webp)
                BLOB-->>UA: blob.url
                UA->>DB: user.update(avatarUrl)
                UA->>UA: revalidateTag(leaderboard)
                UA-->>UI: success + url
            end
        end
    end
    end

    rect rgb(255, 250, 240)
    note over U,DB: Luồng 2 — Đổi mật khẩu (ProfileForm.tsx)
    U->>UI: Nhập mật khẩu cũ + mới
    UI->>PA: changePassword(userId, currentPass, newPass, workspaceId)
    PA->>LIB: getSession()
    alt Không có session
        PA-->>UI: error Unauthorized
    else Đang phiên impersonation
        PA-->>UI: error Không thể đổi mật khẩu khi đang impersonation
    else Session hợp lệ (targetId = session.user.id)
        PA->>DB: user.findUnique(targetId)
        alt user.password null (tài khoản Google OAuth)
            PA-->>UI: error Dùng Quên mật khẩu để đặt mật khẩu lần đầu
        else compare(currentPass) sai
            PA-->>UI: error Mật khẩu hiện tại không đúng
        else Mật khẩu cũ đúng
            PA->>PA: hash(newPass, 12)
            PA->>DB: user.update(password + sessionVersion tăng 1)
            PA->>LIB: login(user với sessionVersion mới) - cấp lại cookie
            PA->>DB: audit auth.password_changed
            PA-->>UI: success
        end
    end
    end

    rect rgb(240, 255, 240)
    note over U,DB: Luồng 3 — Tạo tag (TagLibraryPopup.tsx)
    U->>UI: Tạo tag mới
    UI->>TA: createTag(name, workspaceId)
    TA->>LIB: verifyWorkspaceAccess(workspaceId, ADMIN)
    alt verifyWorkspaceAccess throw (không đủ quyền)
        TA-->>UI: error Forbidden insufficient workspace permissions
    else Đủ quyền ADMIN
        TA->>DB: tagCategory.count(userId) + findFirst(trùng tên)
        alt Quá 15 tags hoặc trùng tên
            TA-->>UI: error Đã đạt giới hạn 15 tags hoặc Tag đã tồn tại
        else Hợp lệ
            TA->>DB: tagCategory.create(name profileId userId workspaceId)
            TA-->>UI: tag mới
        end
    end
    end

    rect rgb(255, 240, 245)
    note over U,DB: Luồng 4 — Global settings tài khoản Frame (global-settings.ts)
    U->>UI: Lưu tài khoản Frame dùng chung
    UI->>GS: updateFrameAccount(account, password)
    GS->>LIB: verifyActiveSession()
    alt Session không active (khóa hoặc chưa đăng nhập)
        GS-->>UI: error Bạn cần đăng nhập
    else Session active
        GS->>DB: task.upsert(id global-system-settings, notes_vi JSON)
        alt DB lỗi
            GS-->>UI: error Failed to update global settings
        else Upsert OK
            GS-->>UI: success
        end
    end
    end

