---
config:
  layout: elk
---
classDiagram
    direction LR

    class UserModel {
        +String id
        +String username
        +String password
        +String avatarUrl
        +String nickname
        +String phoneNumber
        +String paymentQrUrl
        +String paymentBankName
        +String paymentAccountNum
        +Int sessionVersion
        +UserRole role
    }

    class ProfileModel {
        +String id
        +String name
        +String bannerUrl
        +String logoUrl
        +Json settings
        +String status
        +DateTime deletedAt
        +DateTime hardDeleteAfter
    }

    class TagCategoryModel {
        +String id
        +String name
        +String profileId
        +String userId
        +String workspaceId
    }

    class TaskTagModel {
        +String id
        +String taskId
        +String tagCategoryId
    }

    class TaskModel {
        +String id
        +String notes_vi
        +String status
    }

    class ProfilePage {
        +render()
    }
    class ProfileForm {
        +handleUpdateProfile()
        +handleChangePassword()
    }
    class AvatarUpload {
        +handleFile()
    }
    class PaymentQrUpload {
        +handleUpload()
    }
    class ProfileSettingsSection {
        +saveName()
        +savePortalAccent()
    }
    class TagLibraryPopup {
        +handleCreate()
        +handleDelete()
    }

    class ProfileActions {
        +updateProfile(userId, data, workspaceId)
        +changePassword(userId, currentPass, newPass, workspaceId)
        +getProfileSettings(profileId)
        +updateProfileSettings(profileId, data)
        +deleteProfileAction(profileId)
        +restoreProfileAction(profileId)
    }

    class UploadActions {
        +uploadAvatar(userId, formData)
        +uploadPaymentQr(userId, formData)
        +uploadProfileBanner(profileId, formData)
        +uploadProfileLogo(profileId, formData)
    }

    class TagActions {
        +getTagsForUser(workspaceId)
        +createTag(name, workspaceId)
        +updateTag(tagId, name, workspaceId)
        +deleteTag(tagId, workspaceId)
        +setTaskTags(taskId, tagCategoryIds, workspaceId)
        +getTaskTags(taskId)
    }

    class GlobalSettingsActions {
        +getFrameAccount()
        +updateFrameAccount(account, password)
    }

    class AuthLib {
        +getSession()
        +login(userData)
    }
    class SecurityLib {
        +verifyWorkspaceAccess(workspaceId, minRole)
        +verifyActiveSession()
    }
    class ProfilePermissions {
        +getProfileRole(userId, profileId)
        +isSessionLive(session)
    }
    class StorageLib {
        +uploadPublicImage(filename, buffer, contentType)
    }

    ProfilePage --> ProfileForm : render
    ProfilePage --> AvatarUpload : render
    ProfilePage --> PaymentQrUpload : render
    ProfileForm ..> ProfileActions : updateProfile + changePassword
    AvatarUpload ..> UploadActions : uploadAvatar
    PaymentQrUpload ..> UploadActions : uploadPaymentQr
    ProfileSettingsSection ..> ProfileActions : updateProfileSettings
    TagLibraryPopup ..> TagActions : createTag updateTag deleteTag

    ProfileActions ..> AuthLib : getSession login
    ProfileActions ..> ProfilePermissions : getProfileRole isSessionLive
    UploadActions ..> AuthLib : getSession
    UploadActions ..> ProfilePermissions : getProfileRole (verifyProfileOwner)
    UploadActions ..> StorageLib : uploadPublicImage
    TagActions ..> SecurityLib : verifyWorkspaceAccess
    GlobalSettingsActions ..> SecurityLib : verifyActiveSession

    ProfileActions ..> UserModel : update nickname phone password
    ProfileActions ..> ProfileModel : update name settings status
    UploadActions ..> UserModel : update avatarUrl paymentQrUrl
    UploadActions ..> ProfileModel : update bannerUrl logoUrl
    TagActions ..> TagCategoryModel : CRUD
    TagActions ..> TaskTagModel : deleteMany + createMany
    GlobalSettingsActions ..> TaskModel : upsert id global-system-settings

    ProfileModel "1" o-- "n" UserModel : users
    ProfileModel "1" o-- "n" TagCategoryModel : tagCategories
    UserModel "1" o-- "n" TagCategoryModel : owner
    TagCategoryModel "1" o-- "n" TaskTagModel : taskTags
    TaskModel "1" o-- "n" TaskTagModel : tags

