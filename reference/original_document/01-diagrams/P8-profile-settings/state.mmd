%% - Cập nhật settings (không đổi status): src/actions/profile-actions.ts:319-379 (updateProfileSettings — guard isSessionLive + getProfileRole === OWNER)
%% - ACTIVE -> SOFT_DELETED: src/actions/profile-actions.ts:385-424 (deleteProfileAction dòng 399-406 set status SOFT_DELETED, deletedAt, hardDeleteAfter = now + 30 ngày, PROFILE_HARD_DELETE_GRACE_DAYS:280)
%% - SOFT_DELETED -> ACTIVE: src/actions/profile-actions.ts:429-465 (restoreProfileAction dòng 441-448 set status ACTIVE, deletedAt null, hardDeleteAfter null)
