    PREVIEW["Preview deployment\n(push nhánh bất kỳ)"]
    PROD["Production hustlytasker.xyz\n(merge vào main)"]
    CRON["7 Vercel Cron\nsend-digest / check-deadline / cleanup-notifications\nhard-delete-workspaces / hard-delete-profiles\nauth-cleanup / review-janitor"]
    PYFN["api/*.py Python Functions\n(orphan nhưng VẪN deploy — vercel.json:3)"]
  end

  subgraph DATA["Neon Postgres"]
    NEON_MAIN[("DB prod ep-autumn-flower\n(nhận db push từ MỌI build)")]
    NEON_TEST[("TEST branch ep-frosty-forest\n(.env.test — harness QA)")]
  end

  SRC -->|git push nhánh| PREVIEW
  SRC -->|merge main| PROD
  PREVIEW --> BUILD
  PROD --> BUILD
  BUILD -->|prisma db push| NEON_MAIN
  PROD --> CRON
  PROD --> PYFN
  ELECTRON -.->|"chạy local, gọi HTTP cron\n+ DB qua connection string"| NEON_MAIN
