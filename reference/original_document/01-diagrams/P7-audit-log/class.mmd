---
config:
  layout: elk
---
classDiagram
    direction LR

    class AuditLog {
        +BigInt id
        +String workspaceId
        +String actorUserId
        +String userId
        +String action
        +String targetType
        +String targetId
        +Json beforeData
        +Json afterData
        +String ipAddress
        +String userAgent
        +DateTime createdAt
    }

    class ErrorDictionary {
        +String id
        +String code
        +String description
        +Int severity
        +Int penalty
        +Boolean isActive
    }

    class ErrorLog {
        +String id
        +String taskId
        +String userId
        +String errorId
        +Int frequency
        +Int calculatedScore
        +String detectedById
        +String workspaceId
        +String profileId
    }

    class User {
        +String id
        +String username
        +String nickname
    }

    class Workspace {
        +String id
    }

    class Task {
        +String id
        +String title
        +String status
    }

    class AuditLogLib {
        +audit(AuditOpts) void
    }

    class AuditActions {
        +getWorkspaceAuditLogs(workspaceId, filters, page, pageSize) AuditLogResult
        +getAuditLogActionTypes(workspaceId) String[]
        +getAuditLogActors(workspaceId) Actor[]
        -redactSensitive(data) unknown
    }

    class AnalyticsActions {
        +getAnalyticsData(workspaceId)
        +getUserErrorDetails(workspaceId, userId)
        +getUserPerformanceScore(workspaceId, userId)
        +getStaffErrorLogsDetail(workspaceId, userId)
        +removeErrorLog(workspaceId, errorLogId)
    }

    class SecurityLib {
        +verifyWorkspaceAccess(workspaceId, requiredRole)
        +verifyProfileAdminAccess(workspaceId)
    }

    class LogClientErrorRoute {
        +POST(req) NextResponse
    }

    class AdminAuditLogPage {
        +AdminAuditLogPage(params)
    }

    class MissionControlAuditPage {
        +MissionControlAuditPage(params)
    }

    class UserErrorsPage {
        +UserErrorsPage(params)
    }

    class AuditLogViewer {
        +loadLogs(filters, page)
    }

    class MobileAuditLog {
        +render()
    }

    class StaffErrorDetail {
        +handleRemove(errorId)
    }

    class GlobalErrorTsx {
        +reportClientError()
    }

    AuditLog --> Workspace : workspace onDelete Cascade
    AuditLog --> User : actor onDelete SetNull
    AuditLog --> User : user target

    ErrorLog --> ErrorDictionary : error
    ErrorLog --> Task : task onDelete Cascade
    ErrorLog --> User : user vi phạm
    ErrorLog --> User : detectedBy manager
    ErrorLog --> Workspace : workspace onDelete Cascade
    ErrorDictionary o-- ErrorLog : logs

    AuditLogLib ..> AuditLog : prisma create append-only
    AuditActions ..> AuditLog : count findMany distinct
    AuditActions ..> SecurityLib : verifyWorkspaceAccess ADMIN
    AnalyticsActions ..> ErrorLog : groupBy aggregate findMany delete
    AnalyticsActions ..> ErrorDictionary : findMany isActive
    AnalyticsActions ..> SecurityLib : verifyWorkspaceAccess MEMBER-ADMIN

    AdminAuditLogPage ..> AuditActions : Promise.all 3 actions
    AdminAuditLogPage --> AuditLogViewer : desktop
    AdminAuditLogPage --> MobileAuditLog : mobile dispatcher
    MissionControlAuditPage ..> SecurityLib : verifyProfileAdminAccess
    MissionControlAuditPage ..> AuditActions : cùng 3 actions
    MissionControlAuditPage --> AuditLogViewer : tái sử dụng
    AuditLogViewer ..> AuditActions : getWorkspaceAuditLogs filter-page
    UserErrorsPage ..> AnalyticsActions : score + detail
    UserErrorsPage --> StaffErrorDetail : isUserView true
    StaffErrorDetail ..> AnalyticsActions : removeErrorLog
    GlobalErrorTsx ..> LogClientErrorRoute : POST api log-client-error

