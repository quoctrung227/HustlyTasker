stateDiagram-v2
    direction TB

    %% AuditLog và ErrorLog đều KHÔNG có cột status/enum — các trạng thái dưới đây
    %% được SUY từ field thật + hành vi quan hệ (onDelete) trong schema và code.

    state "Vòng đời AuditLog — append-only" as VDAL {
        state "Đã ghi — bất biến, không update hay delete qua API" as DaGhi
        state "Actor ẩn danh — actorUserId về null" as AnDanh
        [*] --> DaGhi : audit() gọi prisma.auditLog.create (không throw, lỗi chỉ console.error)
        DaGhi --> AnDanh : User actor bị xoá (onDelete SetNull)
        DaGhi --> [*] : Workspace bị xoá (onDelete Cascade)
        AnDanh --> [*] : Workspace bị xoá (onDelete Cascade)
    }

    state "Vòng đời ErrorLog — model không có cột status" as VDEL {
        state "Tồn tại — frequency mặc định 1, calculatedScore = frequency x penalty" as TonTai
        note right of TonTai
            Chỉ bị đọc bởi aggregate, groupBy, findMany
            khi tính điểm phạt — đọc không đổi trạng thái.
            Src hiện tại KHÔNG còn đường errorLog.create —
            bản ghi mới chỉ vào bằng tầng dữ liệu (legacy/seed).
        end note
        [*] --> TonTai : bản ghi được tạo (không có đường create trong src hiện tại)
        TonTai --> [*] : Admin xoá qua removeErrorLog (guard ADMIN)
        TonTai --> [*] : Task hoặc User hoặc Workspace bị xoá (onDelete Cascade)
    }

    state "Trạng thái ErrorDictionary theo cột isActive" as VDED {
        state "Đang hiệu lực — isActive true, xuất hiện trong bảng điểm lỗi" as HoatDong
        state "Ngừng hiệu lực — isActive false, bị loại khỏi getUserErrorDetails" as NgungHieuLuc
        [*] --> HoatDong : tạo mã lỗi (isActive mặc định true)
        HoatDong --> NgungHieuLuc : đổi isActive về false (không có đường code trong src — chỉnh ở tầng dữ liệu)
        NgungHieuLuc --> HoatDong : bật lại isActive true
    }

