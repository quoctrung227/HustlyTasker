---
config:
  layout: elk
---
stateDiagram-v2
    state "Task (Task.isArchived + Task.status)" as TaskLC {
        state "Đang hoạt động (isArchived=false)" as T_Active
        state "Đã lưu trữ (isArchived=true, status giữ 'Đã hủy')" as T_Archived
        [*] --> T_Active
        T_Active --> T_Archived : status='Đã hủy' auto-archive
        T_Archived --> T_Active : restoreCancelledTask - status='Nhận task' nếu có assignee, 'Đang đợi giao' nếu chưa
    }

    state "Client (Client.status)" as ClientLC {
        state "ACTIVE" as C_Active
        state "SOFT_DELETED" as C_Trash
        state "MERGED (chỉ migration Canonical Clients ghi)" as C_Merged
        [*] --> C_Active
        C_Active --> C_Trash : deleteClient - cả subtree, deletedAt=now
        C_Trash --> C_Active : restoreClient - chặn nếu trùng tên ACTIVE cùng cấp
        C_Trash --> [*] : permanentlyDeleteClient - thủ công, chặn nếu còn invoice
        C_Merged --> [*] : không hiện trong UI, giữ làm rollback
    }

    state "Workspace (Workspace.status)" as WsLC {
        state "ACTIVE" as W_Active
        state "SOFT_DELETED (hardDeleteAfter = now+30d)" as W_Trash
        [*] --> W_Active
        W_Active --> W_Trash : deleteWorkspaceAction - chỉ OWNER hoặc global admin
        W_Trash --> W_Active : restoreWorkspaceAction - trong 30 ngày
        W_Trash --> [*] : cron hard-delete-workspaces khi hardDeleteAfter lte now
    }

    state "Profile (Profile.status)" as ProfileLC {
        state "ACTIVE" as P_Active
        state "SOFT_DELETED (hardDeleteAfter = now+30d)" as P_Trash
        [*] --> P_Active
        P_Active --> P_Trash : deleteProfileAction - chỉ OWNER, isSessionLive gate
        P_Trash --> P_Active : restoreProfileAction - trong 30 ngày
        P_Trash --> [*] : cron hard-delete-profiles - cascade workspaces/tasks/members
    }

    state "Review item (ReviewFolder/Asset/Version.deletedAt)" as ReviewLC {
        state "Sống (deletedAt=null)" as R_Live
        state "Thùng rác (deletedAt=now, deleteBatchId, purgeAt=+30d)" as R_Trash
        state "Khôi phục về root (orphanedFromPurge=true)" as R_Orphan
        [*] --> R_Live
        R_Live --> R_Trash : deleteItems - quét cả subtree cùng deleteBatchId
        R_Trash --> R_Live : restoreItems - parent còn sống
        R_Trash --> R_Orphan : restoreItems - parent đã mất, re-home về workspace root
        R_Orphan --> R_Trash : deleteItems lại
        R_Trash --> [*] : purgeExpiredTrash cron quá 30 ngày HOẶC purgeItemsAuthorized admin xóa vĩnh viễn - gỡ Mux + R2 trước, xóa row sau
    }

