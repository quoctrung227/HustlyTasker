---
config:
  layout: elk
---
classDiagram
    direction LR

    class IntegrationToken {
        +String id
        +String userId
        +String workspaceId
        +String provider
        +String accessToken
        +String refreshToken
        +DateTime expiresAt
        +String accountEmail
        +DateTime createdAt
        +DateTime updatedAt
    }

    class User {
        +String id
    }

    class Workspace {
        +String id
    }

    class ConnectorsPanel {
        +handleConnect(provider)
        +handleDisconnect(providerId)
    }

    class AddTaskModal {
        +seedHookGraphFromVelox()
    }

    class VeloxMultiHookMapEditor {
        +runScan()
    }

    class GoogleDriveAuthorizeRoute {
        +GET(req)
    }

    class GoogleDriveCallbackRoute {
        +GET(req)
    }

    class DropboxAuthorizeRoute {
        +GET(req)
    }

    class DropboxCallbackRoute {
        +GET(req)
    }

    class ScanFolderRoute {
        +int maxDuration 300
        +POST(req)
    }

    class IntegrationActions {
        +getConnectedIntegrations(workspaceId)
        +disconnectIntegration(workspaceId, provider)
    }

    class IntegrationTokensLib {
        +refreshTokenIfNeeded(tokenRow)
    }

    class TokenEncryption {
        +encryptToken(plain)
        +decryptToken(cipher)
    }

    class CloudLinkParser {
        +parseCloudLink(url)
        +isCloudStorageUrl(url)
    }

    class CloudScanner {
        +scanDropboxFolder(accessToken, folderPath)
        +scanGoogleDriveFolder(accessToken, folderId)
        +recursiveScanFolder(input)
    }

    class VeloxV4Adapter {
        +rawTreeToScanInput(raw, provider, rootName, clientId)
    }

    class VeloxV4Engine {
        +runEngineV4(input)
    }

    class SecurityLib {
        +verifyWorkspaceAccess(workspaceId, role)
    }

    class RateLimitDb {
        +limitDb(key, limit, windowSec)
    }

    User "1" o-- "n" IntegrationToken : userId
    Workspace "1" o-- "n" IntegrationToken : workspaceId

    ConnectorsPanel ..> DropboxAuthorizeRoute : handleConnect redirect
    ConnectorsPanel ..> GoogleDriveAuthorizeRoute : handleConnect redirect
    ConnectorsPanel ..> IntegrationActions : disconnectIntegration

    GoogleDriveCallbackRoute ..> TokenEncryption : encryptToken
    GoogleDriveCallbackRoute --> IntegrationToken : upsert provider google_drive
    DropboxCallbackRoute ..> TokenEncryption : encryptToken
    DropboxCallbackRoute --> IntegrationToken : upsert provider dropbox

    AddTaskModal ..> ScanFolderRoute : POST v=4
    VeloxMultiHookMapEditor ..> ScanFolderRoute : POST v=4

    ScanFolderRoute ..> SecurityLib : verifyWorkspaceAccess MEMBER
    ScanFolderRoute ..> RateLimitDb : limitDb 10 per 60s
    ScanFolderRoute ..> CloudLinkParser : parseCloudLink
    ScanFolderRoute --> IntegrationToken : findUnique userId workspaceId provider
    ScanFolderRoute ..> IntegrationTokensLib : refreshTokenIfNeeded
    ScanFolderRoute ..> CloudScanner : recursiveScanFolder
    ScanFolderRoute ..> VeloxV4Adapter : rawTreeToScanInput
    ScanFolderRoute ..> VeloxV4Engine : runEngineV4

    IntegrationTokensLib ..> TokenEncryption : decryptToken encryptToken
    IntegrationTokensLib --> IntegrationToken : update accessToken expiresAt

    IntegrationActions --> IntegrationToken : findMany findUnique delete
    IntegrationActions ..> TokenEncryption : decryptToken for revoke
    IntegrationActions ..> SecurityLib : verifyWorkspaceAccess MEMBER

