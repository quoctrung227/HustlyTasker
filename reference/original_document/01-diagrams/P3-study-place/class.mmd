%% StudyPlaceActions: src/actions/study-place-actions.ts:50-226
%% StudyPlaceLib: src/lib/study-place.ts:1-150
%% SecurityLib: src/lib/security.ts:38 (verifyWorkspaceAccess), :180 (verifyProfileAdminAccess)
%% Model StudyPlaceProgress: prisma/schema.prisma:1447-1473 (@@unique workspace_user_studySet_question :1470)
