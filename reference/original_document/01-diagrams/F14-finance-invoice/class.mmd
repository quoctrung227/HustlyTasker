---
config:
  layout: elk
---
classDiagram
    direction LR

    class InvoiceModal {
        <<UI Component>>
        +fetchData()
        +refreshProfiles()
        +handleGenerate()
    }

    class RecordPaymentModal {
        <<UI Component>>
        +loadHistory()
        +submit()
    }

    class InvoiceActions {
        <<Server Actions>>
        +getBillingProfiles(workspaceId)
        +createBillingProfile(data)
        +updateBillingProfile(id, data, workspaceId)
        +deleteBillingProfile(id, workspaceId)
        +getUnbilledTasks(clientId, workspaceId)
        +calculateInvoicePreview(taskIds, taxRate, deposit, workspaceId)
        +createInvoiceRecord(data, workspaceId)
        +getClientInvoices(clientId, workspaceId)
        +voidInvoice(invoiceId, workspaceId)
    }

    class PaymentActions {
        <<Server Actions>>
        +recordPayment(input, workspaceId)
        +deletePayment(paymentId, workspaceId)
        +getPaymentLedger(workspaceId)
        +getClientPayments(clientId, workspaceId)
    }

    class ApiInvoicesGenerate {
        <<API Route>>
        +POST(pdfPayload) PdfBuffer
    }

    class ApiInvoiceDownload {
        <<API Route>>
        +GET(id, workspaceId) PdfBuffer
    }

    class InvoiceGeneratorLib {
        <<Lib>>
        +generateInvoicePDF(data) Buffer
    }

    class SecurityLib {
        <<Lib>>
        +verifyFinanceAccess(workspaceId)
        +verifyWorkspaceAccess(workspaceId, role)
    }

    class Invoice {
        <<Prisma Model>>
        +String id
        +String invoiceNumber
        +Int clientId
        +String createdBy
        +DateTime issueDate
        +DateTime dueDate
        +Decimal subtotalAmount
        +Decimal depositDeducted
        +Decimal clientDepositDeducted
        +Decimal taxPercent
        +Decimal taxAmount
        +Decimal totalDue
        +InvoiceStatus status
        +Json billingSnapshot
        +Json clientSnapshot
        +String workspaceId
        +String profileId
    }

    class InvoiceItem {
        <<Prisma Model>>
        +String id
        +String invoiceId
        +String taskId
        +String description
        +Int quantity
        +Decimal unitPrice
        +Decimal amount
    }

    class Payment {
        <<Prisma Model>>
        +String id
        +Int clientId
        +String workspaceId
        +String profileId
        +String invoiceId
        +Decimal amount
        +DateTime paidAt
        +String method
        +String note
        +String recordedById
    }

    class BillingProfile {
        <<Prisma Model>>
        +String id
        +String profileName
        +String beneficiaryName
        +String bankName
        +String accountNumber
        +String swiftCode
        +String currency
        +Boolean isDefault
        +String profileId
    }

    class Client {
        <<Prisma Model>>
        +Int id
        +String name
        +Int parentId
        +Decimal depositBalance
        +String status
        +String profileId
    }

    class Task {
        <<Prisma Model>>
        +String id
        +String title
        +Decimal jobPriceUSD
        +String invoiceId
        +InvoiceTaskStatus invoiceStatus
        +Int clientId
    }

    class InvoiceStatus {
        <<enumeration>>
        DRAFT
        SENT
        PAID
        OVERDUE
        VOID
    }

    class InvoiceTaskStatus {
        <<enumeration>>
        UNBILLED
        INVOICED
    }

    InvoiceModal ..> InvoiceActions : gọi server action
    InvoiceModal ..> ApiInvoicesGenerate : fetch POST tạo PDF
    RecordPaymentModal ..> PaymentActions : gọi server action

    InvoiceActions ..> SecurityLib : verifyFinanceAccess
    PaymentActions ..> SecurityLib : verifyWorkspaceAccess ADMIN
    ApiInvoicesGenerate ..> SecurityLib : verifyFinanceAccess
    ApiInvoiceDownload ..> SecurityLib : verifyFinanceAccess

    ApiInvoicesGenerate ..> InvoiceGeneratorLib : generateInvoicePDF
    ApiInvoiceDownload ..> InvoiceGeneratorLib : generateInvoicePDF
    ApiInvoiceDownload ..> Invoice : đọc invoice + items + client

    InvoiceActions ..> Invoice : create trong transaction
    InvoiceActions ..> Task : claim UNBILLED sang INVOICED
    InvoiceActions ..> Client : trừ hoặc hoàn depositBalance
    InvoiceActions ..> BillingProfile : CRUD + đóng băng billingSnapshot
    PaymentActions ..> Payment : create và delete
    PaymentActions ..> Invoice : update status PAID khi link

    Client "1" o-- "0..n" Invoice : invoices
    Client "1" o-- "0..n" Task : tasks
    Client "1" o-- "0..1" Client : parent và sub-client
    Invoice "1" *-- "1..n" InvoiceItem : items onDelete Cascade
    Invoice "1" o-- "0..n" Task : invoiceId nullable
    InvoiceItem ..> Task : taskId optional
    Payment ..> Invoice : invoiceId scalar không FK
    Payment ..> Client : clientId scalar không FK
    Invoice ..> InvoiceStatus : status
    Task ..> InvoiceTaskStatus : invoiceStatus

