flowchart TB
  classDef danger fill:#ffd6d6,stroke:#c0392b,stroke-width:2px,color:#7b1a1a
  classDef warn fill:#fff3cd,stroke:#e0a800,stroke-width:1px,color:#664d03
  classDef trust fill:#d4edda,stroke:#28a745,stroke-width:1px,color:#14532d
  classDef edge fill:#dbeafe,stroke:#2563eb,stroke-width:1px,color:#1e3a8a
  classDef store fill:#ede9fe,stroke:#7c3aed,stroke-width:1px,color:#4c1d95

  subgraph PUB["BOUNDARY 0 - PUBLIC INTERNET - UNTRUSTED"]
    direction LR
    STAFF["Staff / Admin browser - cookie session JWT HS256"]
    CLIENT["Client - /share/token - NO session, token IS credential"]
    GUESTR["Guest - /r/slug - optional bcrypt password + GuestSession cookie"]
    ATT["Anonymous caller / bot - no credential"]
  end

  subgraph EDGE["BOUNDARY 1 - EDGE MIDDLEWARE middleware.ts - auth-GATE only, NO role, NO DB"]
    direction LR
    MW["decrypt JWT jose HS256 - NO sessionVersion check - CVE-2025-29927 mitigation"]
    MWPUB["/share and /r - PUBLIC early-return + noindex + no-referrer"]
    MWSKIP["/api and /_next - SKIP middleware entirely"]
  end

  subgraph APP["BOUNDARY 2 - SERVER ACTIONS / API - authenticated request, self-verify"]
    direction LR
    ACT["55 server-action files - ~190 fn - call DAL themselves"]
    APIC["39 core API routes - verify inside handler"]
    APIR["44 staff /api/review - requireReviewAccess"]
    APIRG["19 guest /api/r - requireShare gate chain first"]
    SHAREP["~20 portal actions - resolveShareToken every call"]
  end

  subgraph DALB["BOUNDARY 3 - DAL GUARD security.ts / profile-permissions.ts / review/access.ts"]
    direction LR
    VWA["verifyWorkspaceAccess - LOCKED + sessionVersion + ProfileAccess/WorkspaceMember - IDOR block"]
    VPA["verifyProfileAdminAccess = verifyFinanceAccess - OWNER or ADMIN only, no isTreasurer"]
    VAS["verifyActiveSession - read-path DB re-check LOCKED + sessionVersion"]
    RREV["requireReviewAccess - reject LOCKED/CLIENT, workspace-scoped isAdmin"]
    RVGATE["review/share-auth resolveShareGate - bcrypt password + GuestSession sha256"]
    STOK["share-link-auth resolveShareToken - SHA-256 hash-at-rest + 2-tier rate-limit + uniform 404"]
  end

  subgraph DATAZ["BOUNDARY 4 - DATA"]
    direction LR
    NEON[("Neon Postgres via Prisma - sessionVersion source of truth")]
  end

  subgraph EXT["EXTERNAL SERVICES - separate trust boundary, own secrets"]
    direction LR
    MUX["Mux webhook IN - HMAC-SHA256 +-5min timingSafeEqual, fail-closed 401"]
    INC["Inngest - INNGEST_SIGNING_KEY self-verify"]
    R2["Cloudflare R2 - S3 presigned"]
    RES["Resend email"]
    UPS["Upstash Redis rate-limit"]
  end

  subgraph UNAUTH["WARNING - UNAUTHENTICATED ENTRY POINTS - deployed and live"]
    direction LR
    WCAL["/api/webhooks/calendar - verify COMMENTED OUT - logs any POST, no DB write"]
    PYV["api/vdownloader.py - Python Fn - GET, NO auth at all"]
    TESTM["/api/test-email - CRON_SECRET via QUERY PARAM - leaks to access logs"]
    CRONW["6 of 7 cron - plain string compare, NOT timingSafeEqual"]
  end

  STAFF --> MW
  CLIENT --> MWPUB
  GUESTR --> MWPUB
  STAFF -.->|/api bypasses Edge| MWSKIP
  ATT ==>|no auth needed| UNAUTH

  MW --> APP
  MWPUB --> SHAREP
  MWPUB --> APIRG
  MWSKIP --> APIC
  MWSKIP --> APIR

  ACT --> VWA
  ACT --> VAS
  APIC --> VWA
  APIC --> VPA
  APIR --> RREV
  RREV --> VWA
  APIRG --> RVGATE
  SHAREP --> STOK

  VWA --> NEON
  VPA --> NEON
  VAS --> NEON
  RREV --> NEON
  RVGATE --> NEON
  STOK --> NEON

  APP --> EXT
  MUX -->|verified webhook| APIC
  EXT --> NEON

  WCAL -.->|no write| NEON
  PYV ==>|pg8000 DIRECT, bypasses all guards| NEON
  TESTM -.-> RES
  CRONW --> NEON

  class MW,MWPUB,MWSKIP edge
  class VWA,VPA,VAS,RREV,RVGATE,STOK trust
  class NEON store
  class UNAUTH,WCAL,PYV,TESTM,CRONW danger
  style PUB fill:#f8f9fa,stroke:#adb5bd
  style EDGE fill:#eff6ff,stroke:#2563eb
  style APP fill:#f5f5f5,stroke:#868e96
  style DALB fill:#eefaf0,stroke:#28a745
  style DATAZ fill:#f6f3ff,stroke:#7c3aed
  style EXT fill:#fffdf5,stroke:#e0a800
  style UNAUTH fill:#fff0f0,stroke:#c0392b,stroke-width:2px
