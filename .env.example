# Copy this file to .env and replace every required blank value.
# Never commit .env or real secrets.

# Django runtime
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=sdw0x-#qh)t7c6b6)ub5@&s$!e@&=56uie16frp^t$=c2pxu9*
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DRF_NUM_PROXIES=0

# HTTPS and cookie security (development values)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# PostgreSQL shared by Django and Docker Compose
POSTGRES_DB=hustlytasker_db
POSTGRES_USER=hustlytasker_user
POSTGRES_PASSWORD=hustlytasker_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# Django 6.1 mailer. Console is intentionally refused for credential email.
# Invitations return HTTP 503 before creating a row; do not print their tokens.
# For real email, privately configure an Owner-approved SMTP service in .env.
# See documentation/FRONTEND_GUIDE.md, Invitation delivery recovery section.
DJANGO_MAILER_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_SMTP_HOST=smtp.gmail.com
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USERNAME=trungtruong.220704@gmail.com
DJANGO_SMTP_PASSWORD=
DJANGO_SMTP_USE_TLS=true
DJANGO_SMTP_USE_SSL=false
DJANGO_SMTP_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=trungtruong.220704@gmail.com
DJANGO_SERVER_EMAIL=trungtruong.220704@gmail.com

# AI: retain disabled until Owner approves the migration rollout and live test.
DJANGO_AI_LIVE_ENABLED=false
DJANGO_AI_PROVIDER=groq
DJANGO_AI_MODEL=openai/gpt-oss-120b
# Confirm account tier privately before setting this true for Groq.
DJANGO_AI_GROQ_FREE_TIER_CONFIRMED=false
DJANGO_AI_CONTROLLED_LIVE=false
GROQ_API_KEY=your_groq_api_key_here
# Optional Groq limits. Lower them to match the account if necessary.
DJANGO_AI_GROQ_REQUESTS_PER_MINUTE=20
DJANGO_AI_GROQ_REQUESTS_PER_DAY=500
DJANGO_AI_GROQ_TOKENS_PER_MINUTE=6000
DJANGO_AI_GROQ_TOKENS_PER_DAY=100000
# For OpenAI, explicitly select DJANGO_AI_PROVIDER=openai and DJANGO_AI_MODEL=gpt-5.4-mini.
OPENAI_API_KEY=
