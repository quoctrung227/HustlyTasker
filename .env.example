# Copy this file to .env and replace every required blank value.
# Never commit .env or real secrets.

# Django runtime
DJANGO_ENVIRONMENT=development
DJANGO_SECRET_KEY=sdw0x-#qh)t7c6b6)ub5@&s$!e@&=56uie16frp^t$=c2pxu9*
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=
DRF_NUM_PROXIES=0

# HTTPS and cookie security (development values)
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# PostgreSQL shared by Django and Docker Compose
POSTGRES_DB=hustlytasker_db
POSTGRES_USER=hustlytasker_user
POSTGRES_PASSWORD=hustlytasker_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_BIND_ADDRESS=127.0.0.1

# Django 6.1 mailer. The console backend is for development only.
DJANGO_MAILER_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_SMTP_HOST=
DJANGO_SMTP_PORT=587
DJANGO_SMTP_USERNAME=
DJANGO_SMTP_PASSWORD=
DJANGO_SMTP_USE_TLS=true
DJANGO_SMTP_USE_SSL=false
DJANGO_SMTP_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=webmaster@localhost
DJANGO_SERVER_EMAIL=root@localhost
